# name: test/sql/aggregate/aggregates/arg_min_max_n_keys.test
# description: arg_min/arg_max and min/max with n over keys compared as 128-bit integers, intervals, strings and sort keys
# group: [aggregates]

statement ok
CREATE TABLE h AS SELECT i, (i - 50)::HUGEINT * 100000000000000000000 AS k, (i * 7)::UHUGEINT * 1000000000000000000000 AS u FROM range(100) t(i)

query II
SELECT arg_max(i, k, 3), arg_min(i, k, 3) FROM h
----
[99, 98, 97]	[0, 1, 2]

query II
SELECT arg_max(i, u, 2), arg_min(i, u, 2) FROM h
----
[99, 98]	[0, 1]

query I
SELECT arg_max_nulls_last(i, CASE WHEN i % 10 = 0 THEN NULL ELSE k END, 3) FROM h
----
[99, 98, 97]

query I
SELECT arg_min_nulls_last(i, CASE WHEN i < 3 THEN NULL ELSE u END, 2) FROM h
----
[3, 4]

statement ok
CREATE TABLE iv AS SELECT * FROM (VALUES (1, INTERVAL '1 month'), (2, INTERVAL '29 days'), (3, INTERVAL '31 days'), (4, INTERVAL '1 month 2 days'), (5, INTERVAL '-1 day'), (6, INTERVAL '23 hours'), (7, INTERVAL '1 day 1 hour'), (8, INTERVAL '30 days 1 second')) t(i, v)

query II
SELECT arg_max(i, v, 3), arg_min(i, v, 3) FROM iv
----
[4, 3, 8]	[5, 6, 7]

query I
SELECT arg_max_nulls_last(i, CASE WHEN i = 3 THEN NULL ELSE v END, 2) FROM iv
----
[4, 8]

statement ok
CREATE TABLE s AS SELECT * FROM (VALUES (1, 'abcdefghijklmnop'), (2, 'abcdefghijklmnopq'), (3, 'abcdefghijklmno'), (4, 'abcdefghijklmnop' || chr(0)), (5, 'abcdefghijklmnoq'), (6, ''), (7, 'abcdefghijklmnopz'), (8, 'abc' || chr(0)), (9, 'abc')) t(i, v)

query II
SELECT arg_max(i, v, 9), arg_min(i, v, 9) FROM s
----
[5, 7, 2, 4, 1, 3, 8, 9, 6]	[6, 9, 8, 3, 1, 4, 2, 7, 5]

query II
SELECT max(v, 3), min(v, 2) FROM s
----
[abcdefghijklmnoq, abcdefghijklmnopz, abcdefghijklmnopq]	['', abc]

query I
SELECT arg_min_nulls_last(i, CASE WHEN i = 6 THEN NULL ELSE v END, 3) FROM s
----
[9, 8, 3]

statement ok
CREATE TABLE l AS SELECT i, [i % 3, 100 - i] AS v FROM range(10) t(i)

query II
SELECT arg_max(i, v, 3), arg_min(i, v, 3) FROM l
----
[2, 5, 8]	[9, 6, 3]

query I
SELECT max(v, 2) FROM l
----
[[2, 98], [2, 95]]
