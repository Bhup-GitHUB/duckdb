# name: test/sql/function/numeric/test_invalid_math.test
# description: Test invalid input for math functions
# group: [numeric]

statement ok
SET ieee_floating_point_ops = false;

# cannot take log of negative number or zero
statement error
SELECT log(0);
----

statement error
SELECT log(-1);
----

statement error
SELECT ln(0);
----

statement error
SELECT ln(-1);
----

statement error
SELECT log10(0);
----

statement error
SELECT log10(-1);
----

# cannot take square root of a negative number
statement error
SELECT sqrt(-1);
----

query I
SELECT SQRT(0)
----
0

statement error
SELECT POW(1e300,100)
----
value out of range: overflow

statement error
SELECT POW(-1e300,100)
----
value out of range: overflow

statement error
SELECT POW(1e-300,100)
----
value out of range: underflow

query R
SELECT POW(-1.0, 0.5)
----
nan

statement error
SELECT EXP(1e300)
----
value out of range: overflow

statement error
SELECT EXP(-1e300)
----
value out of range: underflow

query RRR
SELECT EXP('inf'::DOUBLE), EXP('-inf'::DOUBLE), EXP(0)
----
inf	0.0	1.0

query R
SELECT DEGREES(1e308)
----
inf

statement ok
RESET ieee_floating_point_ops;
