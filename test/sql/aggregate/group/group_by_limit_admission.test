# name: test/sql/aggregate/group/group_by_limit_admission.test
# description: a GROUP BY or DISTINCT under a LIMIT, or under an ORDER BY of its groups with a LIMIT, aggregates only the groups it can return, completely
# group: [group]

statement ok
SET threads = 8

statement ok
CREATE TABLE t AS SELECT i, (i % 1000) * 1000000007 AS g, (i % 7)::VARCHAR AS s, CASE WHEN i % 13 = 0 THEN NULL ELSE i % 5 END AS n FROM range(2000000) r(i)

query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g LIMIT 10
----
physical_plan	<REGEX>:.*Group Limit: 10.*

query II
EXPLAIN SELECT DISTINCT s FROM t LIMIT 3
----
physical_plan	<REGEX>:.*LIMITED_DISTINCT.*

query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g LIMIT 5 OFFSET 3
----
physical_plan	<REGEX>:.*Group Limit: 8.*

query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g HAVING count(*) > 0 LIMIT 10
----
physical_plan	<!REGEX>:.*Group Limit.*

query II
EXPLAIN SELECT g, count(DISTINCT s) FROM t GROUP BY g LIMIT 10
----
physical_plan	<REGEX>:.*Group Limit: 10.*

query II
SELECT count(*), bool_and(cd = 7) FROM (SELECT g, count(DISTINCT s) AS cd FROM t GROUP BY g LIMIT 10)
----
10	true

query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g ORDER BY g LIMIT 10
----
physical_plan	<REGEX>:.*Group Limit: 10.*

query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g ORDER BY count(*) DESC, g LIMIT 10
----
physical_plan	<!REGEX>:.*Group Limit.*

query II
SELECT count(*), bool_and(c = 2000 AND sm = (SELECT sum(i) FROM t WHERE t.g = r.g)) FROM (SELECT g, count(*) AS c, sum(i) AS sm FROM t GROUP BY g LIMIT 10) r
----
10	true

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM t WHERE t.g = r.g AND t.s = r.s)) FROM (SELECT g, s, count(*) AS c FROM t GROUP BY g, s LIMIT 100 OFFSET 20) r
----
100	true

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM t WHERE t.n IS NOT DISTINCT FROM r.n)) FROM (SELECT n, count(*) AS c FROM t GROUP BY n LIMIT 10) r
----
6	true

query I
SELECT count(*) FROM (SELECT DISTINCT g FROM t LIMIT 7)
----
7

query I
SELECT count(DISTINCT g) FROM (SELECT DISTINCT g FROM t LIMIT 2048)
----
1000

query II
SELECT count(*), sum(c) FROM (SELECT s, count(*) AS c FROM t GROUP BY s LIMIT 10)
----
7	2000000

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM t WHERE (t.i % 1000) - 500 = r.k)) FROM (SELECT (i % 1000) - 500 AS k, count(*) AS c FROM t GROUP BY k LIMIT 10) r
----
10	true

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM t WHERE DATE '2020-01-01' + (t.i % 1000)::INTEGER = r.k)) FROM (SELECT DATE '2020-01-01' + (i % 1000)::INTEGER AS k, count(*) AS c FROM t GROUP BY k LIMIT 10) r
----
10	true

statement ok
CREATE TABLE d AS SELECT CASE WHEN i % 11 = 0 THEN NULL ELSE 2000000 - i END AS k, i % 3 AS s FROM range(2000000) r(i)

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM d WHERE d.k IS NOT DISTINCT FROM r.k AND d.s = r.s)) FROM (SELECT k, s, count(*) AS c FROM d GROUP BY k, s LIMIT 10) r
----
10	true

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM d WHERE d.k IS NOT DISTINCT FROM r.k)) FROM (SELECT k, count(*) AS c FROM d GROUP BY k LIMIT 2048) r
----
2048	true

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM d WHERE d.k IS NOT DISTINCT FROM r.k)) FROM (SELECT k, count(*) AS c FROM d GROUP BY k LIMIT 5000) r
----
5000	true

query II
SELECT g, count(*) FROM t GROUP BY g ORDER BY g DESC LIMIT 3
----
999000006993	2000
998000006986	2000
997000006979	2000

query II
SELECT n, count(*) FROM t GROUP BY n ORDER BY n NULLS FIRST LIMIT 3
----
NULL	153847
0	369230
1	369231

query II
SELECT n, count(*) FROM t GROUP BY n ORDER BY n DESC NULLS LAST LIMIT 3 OFFSET 1
----
3	369230
2	369231
1	369231

query III
SELECT s, g, count(*) FROM t GROUP BY g, s ORDER BY s DESC, g LIMIT 3
----
6	0	286
6	1000000007	286
6	2000000014	286

query II
SELECT count(*), k FROM d GROUP BY k ORDER BY k LIMIT 3
----
1	1
1	3
1	4

query II
SELECT k, count(*) FROM d GROUP BY k ORDER BY k DESC NULLS FIRST LIMIT 3
----
NULL	181819
1999999	1
1999998	1

query III
SELECT k, s, count(*) FROM d GROUP BY s, k ORDER BY k DESC NULLS LAST, s LIMIT 2 OFFSET 2046
----
1997749	1	1
1997748	2	1

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM t WHERE t.s = r.s AND t.g = r.g) AND s = '0') FROM (SELECT s, g, count(*) AS c FROM t GROUP BY s, g ORDER BY s LIMIT 100) r
----
100	true

statement ok
CREATE TABLE narrow AS SELECT (1000 + i % 100)::INTEGER AS x, 'a string longer than its inline bytes ' || (i % 7) AS s FROM range(2400000) r(i)

query III
SELECT x, s, count(*) FROM narrow GROUP BY x, s ORDER BY x, s LIMIT 3
----
1000	a string longer than its inline bytes 0	3429
1000	a string longer than its inline bytes 1	3428
1000	a string longer than its inline bytes 2	3429

query III
SELECT x, s, count(*) FROM narrow GROUP BY x, s ORDER BY x DESC, s DESC LIMIT 2
----
1099	a string longer than its inline bytes 6	3428
1099	a string longer than its inline bytes 5	3429

query I
SELECT count(*) FROM (SELECT x, s FROM narrow GROUP BY x, s LIMIT 5)
----
5

statement ok
CREATE TABLE w AS SELECT i // 7 AS a, (1000 + i % 50)::INTEGER AS b FROM range(2000000) r(i)

query II
EXPLAIN SELECT a, b, count(*) FROM w GROUP BY a, b ORDER BY a, b LIMIT 4
----
physical_plan	<REGEX>:.*Group Limit: 4.*__internal_compress_integral.*

query III
SELECT a, b, count(*) FROM w GROUP BY a, b ORDER BY a, b LIMIT 4
----
0	1000	1
0	1001	1
0	1002	1
0	1003	1

query III
SELECT b, a, count(*) FROM w GROUP BY a, b ORDER BY b DESC, a LIMIT 3
----
1049	7	1
1049	14	1
1049	21	1

statement ok
CREATE TABLE days AS SELECT DATE '2024-01-01' + (i // 10000)::INTEGER AS day, i FROM range(1000000) r(i)

query II
EXPLAIN SELECT day, count(*) FROM days GROUP BY day ORDER BY day DESC LIMIT 3
----
physical_plan	<!REGEX>:.*Group Limit.*

query II
SELECT day, count(*) FROM days GROUP BY day ORDER BY day DESC LIMIT 3
----
2024-04-09	10000
2024-04-08	10000
2024-04-07	10000

query II
SELECT count(*), bool_and(c = 10000) FROM (SELECT day, count(*) AS c FROM days GROUP BY day LIMIT 5)
----
5	true

statement ok
SET threads = 1

query II
EXPLAIN ANALYZE SELECT k, count(*) FROM d GROUP BY k LIMIT 10
----
analyzed_plan	<REGEX>:.*Row Groups Scanned: 1 / 17.*

query II
SELECT count(*), bool_and(c = 1) FROM (SELECT k, count(*) AS c FROM d WHERE k IS NOT NULL GROUP BY k LIMIT 10)
----
10	true

statement ok
CREATE TABLE skewed AS SELECT CASE WHEN i % 10 = 0 THEN i ELSE 0 END AS k FROM range(1000000) r(i)

query II
EXPLAIN SELECT k, count(*) FROM skewed GROUP BY k LIMIT 10
----
physical_plan	<REGEX>:.*Dynamic Filter \(k ?>= ?\?\).*

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM skewed s WHERE s.k = r.k)) FROM (SELECT k, count(*) AS c FROM skewed GROUP BY k LIMIT 10) r
----
10	true

query II
EXPLAIN SELECT k, count(*) FROM d GROUP BY k LIMIT 10
----
physical_plan	<REGEX>:.*Dynamic Filter \(k ?<= ?\?\).*

statement ok
CREATE TABLE fallback AS SELECT i % 2 = 0 AS b, CASE WHEN i < 122880 THEN NULL ELSE i % 1000 END AS k FROM range(3 * 122880) r(i)

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM fallback f WHERE f.b = r.b)) FROM (SELECT b, count(*) AS c FROM fallback GROUP BY b LIMIT 1) r
----
1	true

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM fallback f WHERE f.k IS NOT DISTINCT FROM r.k)) FROM (SELECT k, count(*) AS c FROM fallback GROUP BY k LIMIT 10) r
----
10	true

query II
SELECT count(*), bool_and(c = 1) FROM (SELECT rowid AS id, count(*) AS c FROM fallback GROUP BY rowid LIMIT 10) r
----
10	true

query II
SELECT count(*), bool_and(c = 1) FROM (SELECT range AS v, count(*) AS c FROM range(100000) GROUP BY range LIMIT 10) r
----
10	true

statement ok
BEGIN

statement ok
INSERT INTO fallback SELECT i % 3 = 0, i % 50 FROM range(5000) r(i)

query II
SELECT count(*), bool_and(c = (SELECT count(*) FROM fallback f WHERE f.k IS NOT DISTINCT FROM r.k)) FROM (SELECT k, count(*) AS c FROM fallback GROUP BY k LIMIT 10) r
----
10	true

statement ok
ROLLBACK

query II
EXPLAIN WITH RECURSIVE q(i, x) AS (SELECT 0, range FROM range(10000) UNION ALL SELECT i + 1, x + 100000 * c FROM (SELECT i, x, count(*) AS c FROM q GROUP BY i, x ORDER BY x LIMIT 100) t WHERE i < 3) SELECT i, count(*), min(x), max(x) FROM q GROUP BY i ORDER BY i
----
physical_plan	<REGEX>:.*Group Limit: 100.*

query IIII
WITH RECURSIVE q(i, x) AS (SELECT 0, range FROM range(10000) UNION ALL SELECT i + 1, x + 100000 * c FROM (SELECT i, x, count(*) AS c FROM q GROUP BY i, x ORDER BY x LIMIT 100) t WHERE i < 3) SELECT i, count(*), min(x), max(x) FROM q GROUP BY i ORDER BY i
----
0	10000	0	9999
1	100	100000	100099
2	100	200000	200099
3	100	300000	300099

query IIII
WITH RECURSIVE q(i, x) AS (SELECT 0, range FROM range(10000) UNION ALL SELECT i + 1, x + 100000 * c FROM (SELECT i, x, count(*) AS c FROM q GROUP BY i, x ORDER BY x DESC LIMIT 100) t WHERE i < 3) SELECT i, count(*), min(x), max(x) FROM q GROUP BY i ORDER BY i
----
0	10000	0	9999
1	100	109900	109999
2	100	209900	209999
3	100	309900	309999
