# name: test/sql/function/string/regex_invalid_pattern.test
# description: A pattern that fails to compile raises invalid regular expression, constant or per row
# group: [string]

statement ok
CREATE TABLE patterns AS SELECT 'abc' AS s, '(' AS p;

statement error
SELECT regexp_matches('abc', '(')
----
