# name: test/sql/function/string/test_string_size_limit.test_slow
# description: A string result over the maximum string size fails with an object size error from any function
# group: [string]

statement error
SELECT length(r || r) FROM (SELECT repeat('x', 2147483648) AS r) t
----
<REGEX>:.*Object Size Error.*maximum supported string size.*

statement error
SELECT length(concat(r, r)) FROM (SELECT repeat('x', 2147483648) AS r) t
----
<REGEX>:.*Object Size Error.*maximum supported string size.*

statement error
SELECT length(replace(r, 'x', 'xx')) FROM (SELECT repeat('x', 2147483648) AS r) t
----
<REGEX>:.*Object Size Error.*maximum supported string size.*
