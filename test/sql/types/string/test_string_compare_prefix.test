# name: test/sql/types/string/test_string_compare_prefix.test
# description: string ordering decided in the 4-byte prefix, past it, across the 12-byte inline boundary and by length
# group: [string]

statement ok
CREATE TABLE s AS SELECT * FROM (VALUES
	(0, ''),
	(1, 'a'),
	(2, 'ab'),
	(3, 'abc'),
	(4, 'abcd'),
	(5, 'abcd' || chr(1)),
	(6, 'abcde'),
	(7, 'abcdefghijkl'),
	(8, 'abcdefghijklm'),
	(9, 'abcdefghijklmn'),
	(10, 'abcdefghijkm'),
	(11, 'abcdf'),
	(12, 'abcdz'),
	(13, 'abcdé'),
	(14, 'abce'),
	(15, 'b'),
	(16, 'z'),
	(17, 'é')
) t(r, v)

query I
SELECT count(*) FROM s l, s r WHERE (l.v < r.v) <> (l.r < r.r) OR (l.v > r.v) <> (l.r > r.r) OR (l.v = r.v) <> (l.r = r.r) OR (l.v IS DISTINCT FROM r.v) <> (l.r <> r.r)
----
0

statement ok
CREATE TABLE b AS SELECT * FROM (VALUES
	(0, '\x61\x62'::BLOB),
	(1, '\x61\x62\x00'::BLOB),
	(2, '\x61\x62\x00\x00'::BLOB),
	(3, '\x61\x62\x00\x00\x00'::BLOB),
	(4, '\x61\x62\x00\x00\x01'::BLOB),
	(5, '\x61\x62\x00\x01'::BLOB),
	(6, '\x61\x62\x01'::BLOB)
) t(r, v)

query I
SELECT count(*) FROM b l, b r WHERE (l.v < r.v) <> (l.r < r.r) OR (l.v > r.v) <> (l.r > r.r) OR (l.v = r.v) <> (l.r = r.r)
----
0

statement ok
CREATE TABLE w AS SELECT DISTINCT v FROM (
	SELECT left(base, n) AS v FROM (SELECT 'abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGH' AS base), range(45) t(n)
	UNION ALL
	SELECT left(left(base, p) || chr(ascii(substr(base, p + 1, 1)) + d) || substr(base, p + 2), CASE WHEN k = 0 THEN p + 1 ELSE 44 END) AS v
	FROM (SELECT 'abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGH' AS base), range(44) t(p), (VALUES (-1), (1)) s(d), range(2) u(k)
)

statement ok
CREATE TABLE wr AS SELECT v, dense_rank() OVER (ORDER BY v) AS r FROM w

query II
SELECT count(*), max(r) FROM wr
----
219	219

query I
SELECT count(*) FROM wr l, wr r WHERE (l.v < r.v) <> (l.r < r.r) OR (l.v > r.v) <> (l.r > r.r) OR (l.v = r.v) <> (l.r = r.r)
----
0

statement ok
CREATE TABLE z AS SELECT DISTINCT unhex(v) AS v FROM (
	SELECT left(base, 2 * n) AS v FROM (SELECT '6162636465660000000000006768696A0000000000000000' AS base), range(25) t(n)
	UNION ALL
	SELECT left(left(base, 2 * p) || x || substr(base, 2 * p + 3), CASE WHEN k = 0 THEN 2 * p + 2 ELSE 48 END) AS v
	FROM (SELECT '6162636465660000000000006768696A0000000000000000' AS base), range(24) t(p), (VALUES ('00'), ('01'), ('FF')) s(x), range(2) u(k)
)

statement ok
CREATE TABLE zr AS SELECT v, dense_rank() OVER (ORDER BY v) AS r FROM z

query I
SELECT count(*) FROM zr l, zr r WHERE (l.v < r.v) <> (l.r < r.r) OR (l.v > r.v) <> (l.r > r.r) OR (l.v = r.v) <> (l.r = r.r)
----
0

statement ok
CREATE TABLE big AS SELECT r, v FROM s, range(1000) t(i)

query II
SELECT r, count(*) FROM (SELECT r, v FROM big ORDER BY v LIMIT 3500) GROUP BY r ORDER BY r
----
0	1000
1	1000
2	1000
3	500

query II
SELECT r, count(*) FROM (SELECT r, v FROM big ORDER BY v DESC LIMIT 2500) GROUP BY r ORDER BY r
----
15	500
16	1000
17	1000

query II
SELECT r, count(*) FROM big GROUP BY r, v ORDER BY v DESC LIMIT 4
----
17	1000
16	1000
15	1000
14	1000

query II
SELECT r, count(*) FROM big GROUP BY r, v ORDER BY v LIMIT 3 OFFSET 7
----
7	1000
8	1000
9	1000
