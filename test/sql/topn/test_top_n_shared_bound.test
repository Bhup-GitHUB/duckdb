# name: test/sql/topn/test_top_n_shared_bound.test
# description: a Top-N whose limit takes many vectors to fill bounds its input from all threads' partial heaps, and still returns exactly its rows
# group: [topn]

statement ok
SET threads = 8

statement ok
CREATE TABLE t AS SELECT x, x % 13 AS y, CASE WHEN x % 1009 = 0 THEN NULL ELSE x END AS z FROM (SELECT (i * 7919) % 6000000 AS x FROM range(6000000) r(i))

query II
EXPLAIN SELECT x FROM t ORDER BY x LIMIT 20000
----
physical_plan	<REGEX>:(?s).*TOP_N.*

query IIII
SELECT count(*), min(x), max(x), sum(x) FROM (SELECT x FROM t ORDER BY x LIMIT 20000)
----
20000	0	19999	199990000

query II
EXPLAIN SELECT x FROM t ORDER BY x DESC LIMIT 20000 OFFSET 1000
----
physical_plan	<REGEX>:(?s).*TOP_N.*

query IIII
SELECT count(*), min(x), max(x), sum(x) FROM (SELECT x FROM t ORDER BY x DESC LIMIT 20000 OFFSET 1000)
----
20000	5979000	5998999	119779990000

query II
EXPLAIN SELECT y, x FROM t ORDER BY y DESC, x LIMIT 30000
----
physical_plan	<REGEX>:(?s).*TOP_N.*

query IIII
SELECT count(*), min(y), max(x), sum(x) FROM (SELECT y, x FROM t ORDER BY y DESC, x LIMIT 30000)
----
30000	12	389999	5850165000

query II
EXPLAIN SELECT z FROM t ORDER BY z NULLS FIRST LIMIT 20000
----
physical_plan	<REGEX>:(?s).*TOP_N.*

query IIII
SELECT count(*), count(z), max(z), sum(z) FROM (SELECT z FROM t ORDER BY z NULLS FIRST LIMIT 20000)
----
20000	14053	14066	98841392
